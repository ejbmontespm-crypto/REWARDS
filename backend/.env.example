# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube a git (ver .gitignore).

# Connection string de Supabase — Project Settings > Database > Connect > Session pooler
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres

# Puerto local del backend
PORT=3000

# Secreto para firmar los JWT de staff/admin — genera uno largo y aleatorio,
# distinto en cada entorno (dev/producción). Ejemplo para generarlo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión de staff/admin
JWT_EXPIRES_IN=12h

# Secreto para firmar el token dinámico del QR del cliente — distinto de
# JWT_SECRET a propósito (son dos cosas distintas: sesión de staff vs.
# identidad momentánea de cliente en el escaneo).
QR_SECRET=

# Proyecto de Supabase — Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key — Project Settings > API > "service_role" (secret).
# NUNCA la uses en el panel ni en la app (esas usan la anon key). Se salta
# por completo las reglas de RLS: solo vive aquí, en el backend.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar el JWT de sesión del cliente — distinto de JWT_SECRET
# (staff) y de QR_SECRET (identidad momentánea del escaneo). Cubre dos casos
# que no pasan por Supabase Auth: el "primer login implícito" al registrarse,
# y el acceso asistido con código presencial.
CLIENTE_SECRET=

# Mercado Pago (opcional — fase A ronda 4, punto 9). Sin esto, /pagos regresa
# un error claro en vez de tronar. Access Token de prueba o real:
# https://www.mercadopago.com.mx/developers/panel > Tus integraciones > (tu app) > Credenciales
MERCADOPAGO_ACCESS_TOKEN=
# device_id de la terminal Point física, una vez vinculada (GET
# /api/pagos/mercadopago/terminal/dispositivos, con el token ya conectado,
# ayuda a encontrarlo la primera vez)
MERCADOPAGO_POINT_DEVICE_ID=
# URL pública donde Mercado Pago puede llamar al webhook (tu backend
# desplegado + /api/pagos/mercadopago/webhook) — vacío mientras solo pruebes
# en local, ver mailer/notas del backend/README.md
MERCADOPAGO_NOTIFICATION_URL=
# A dónde regresa el cliente tras pagar por liga (pantalla de "tu pedido",
# por ejemplo) — vacío usa el default de Mercado Pago
MERCADOPAGO_BACK_URL=
