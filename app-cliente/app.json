{
  "expo": {
    "name": "Lealtad Café",
    "slug": "app-cliente",
    "scheme": "lealtadcafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf7f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.lealtadcafe.cliente"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos tu cámara para escanear el QR del cliente.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "with-rn-bluetooth-classic"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1a15492-9d0d-4d14-8853-934cf629c8f4"
      }
    },
    "owner": "beme9502"
  }
}
